meta {
  name: List - no token
  type: http
  seq: 5
}

get {
  url: {{apiUrl}}/users/me/notifications
  body: none
  auth: none
}

assert {
  res.status: eq 401
  res.body.success: eq false
  res.body.error.code: eq UNAUTHORIZED
}

docs {
  Same purpose as the other `- no token` negative cases (see README's table): catches
  `NotificationModule` silently losing `imports: [AuthModule]`, which would otherwise return
  200 with an empty/wrong list and nothing else noticing.
}
