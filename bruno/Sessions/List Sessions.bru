meta {
  name: List Sessions
  type: http
  seq: 3
}

get {
  url: {{apiUrl}}/sessions?city=HCM&area=HCM_DISTRICT_10
  body: none
  auth: none
}

params:query {
  city: HCM
  area: HCM_DISTRICT_10
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("includes the session created in this run", function () {
    const sessions = res.getBody().data;
    expect(sessions.map(s => s.id)).to.include(bru.getEnvVar("sessionId"));
  });
}

docs {
  Implemented: `ListSessionsByDistrictUseCase` + `ListSessionsByDistrictDto`, `GSI1PK =
  SLOC#<city>#<area> AND GSI1SK >= :from` (defaults `from` to now when omitted).

  **Known gap:** like the courts list, the city/area pair is never checked against
  `CITY_AREAS` -- a mismatched pair returns `200` with `[]` instead of a 400.

  If this ever returns an empty list unexpectedly, verify GSI1 directly before suspecting
  the route:

      aws dynamodb query --table-name <table> --index-name GSI1 \
        --key-condition-expression 'GSI1PK = :loc' \
        --expression-attribute-values '{":loc":{"S":"SLOC#HCM#HCM_DISTRICT_10"}}'

  That must return the session META item and **not** any REQUEST or COURT item -- requests
  carry no GSI1 keys at all, and courts are filed under `CLOC#...` instead.
}
