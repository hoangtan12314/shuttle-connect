meta {
  name: Withdraw Request - approved
  type: http
  seq: 14
}

patch {
  url: {{apiUrl}}/sessions/{{sessionId}}/requests/mine/withdraw
  body: none
  auth: bearer
}

auth:bearer {
  token: {{idToken2}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.status: eq WITHDRAWN
}

docs {
  Depends on **Approve Request (for withdraw test)**. `wasApproved: true`, so
  `withdrawRequest` takes `revertApproval`'s shape -- gives the slot back and flips
  `FULL -> OPEN` if needed -- but lands the request on `WITHDRAWN` instead of `PENDING`.
  **Get Session After Withdraw** below checks the slot actually came back. This session's
  start time is "tomorrow" (**Sessions / Create Session**), well outside the 6h cutoff, so
  this isn't blocked by `WithdrawalWindowClosedError` -- see **Withdraw Cutoff** for that
  check.
}
