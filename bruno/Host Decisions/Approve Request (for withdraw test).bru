meta {
  name: Approve Request (for withdraw test)
  type: http
  seq: 13
}

patch {
  url: {{apiUrl}}/sessions/{{sessionId}}/requests/{{playerId}}
  body: json
  auth: inherit
}

body:json {
  {
    "status": "APPROVED"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.status: eq APPROVED
}

docs {
  Depends on **Undo Rejection** having put the shared request back to `PENDING`. Re-approves
  it (run as the host, like **Approve Request**) purely to set up **Withdraw Request -
  approved** below -- needs an `APPROVED` request to withdraw from, to exercise the
  slot-giveback transaction path, which the plain `PENDING` withdraw case (now covered by
  **Withdraw Cutoff**'s control case instead of here -- see that folder) doesn't exercise.
}
