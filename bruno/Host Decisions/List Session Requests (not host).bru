meta {
  name: List Session Requests (not host)
  type: http
  seq: 2
}

get {
  url: {{apiUrl}}/sessions/{{sessionId}}/requests
  body: none
  auth: bearer
}

auth:bearer {
  token: {{idToken2}}
}

assert {
  res.status: eq 403
  res.body.success: eq false
  res.body.error.code: eq FORBIDDEN
}

docs {
  Implemented and passing (see **List Session Requests (host)**'s docs for the DI-gap
  history). Same route, run as the **player** instead. The player
  requested to join this session but doesn't host it, so they must not be able to see the
  list -- `GetRequestsUseCase` checks `session.host.id === userId` and throws
  `ForbiddenError` (403) before ever calling the request repository, so this one doesn't
  depend on the missing `return` bug either.
}
