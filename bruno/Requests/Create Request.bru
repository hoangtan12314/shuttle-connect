meta {
  name: Create Request
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/requests
  body: json
  auth: bearer
}

auth:bearer {
  token: {{idToken2}}
}

body:json {
  {
    "sessionId": "{{sessionId}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("playerId", res.getBody().data.user.id);
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.status: eq PENDING
}

tests {
  test("returns a full RequestItemResponse, owned by the player, against the host's session", function () {
    const request = res.getBody().data;
    expect(request.session.id).to.equal(bru.getEnvVar("sessionId"));
    expect(request.user.id).to.be.a("string");
    expect(request.user.id).to.not.equal(bru.getEnvVar("userId"));   // player, not host
    expect(request.court.name).to.be.a("string");   // denormalized onto the request, not just a court id
  });
}

docs {
  Creates a join request against the host's session, run as the **player**
  (`{{idToken2}}`) -- not the host. Once D4 lands (`CannotJoinOwnSessionError`), the host
  can no longer join their own session, so every "someone joins" test from here on has to
  be a second person. Run **Auth / Login as Player** first.

  Written item shape: `PK=SESSION#<id>`, `SK=REQUEST#USER#<userId>`, plus `location`
  and `session_start_time` / `session_end_time`. The times are named `session_*` on
  purpose -- a bare `start_time` alongside `location` would put this request into the
  browse index, which must return sessions only.

  **Response shape note:** `CreateRequestUseCase` used to return the raw `Request` domain
  entity (`{userId, sessionId, status, createdAt}`, flat, no court/user denormalization) --
  fixed to return a proper `RequestItemResponse` (nested `user`/`session`/`court`, matching
  what `GET /requests/mine` already returned), assembled from the `session`/`user` objects
  already fetched for validation, no extra DynamoDB read. `playerId` is now captured from
  `data.user.id`, not the old flat `data.userId`.
}
