meta {
  name: My Requests
  type: http
  seq: 6
}

get {
  url: {{apiUrl}}/requests/mine
  body: none
  auth: bearer
}

auth:bearer {
  token: {{idToken2}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("includes the request this user made, still pending", function () {
    const requests = res.getBody().data;
    const mine = requests.find(r => r.session.id === bru.getEnvVar("sessionId"));
    expect(mine).to.exist;
    expect(mine.status).to.equal("PENDING");
  });
}

docs {
  Implemented. Runs as the **player** (`{{idToken2}}`), who is the one who actually sent
  a join request -- the host never requests anything. `GSI2PK = USER#<me>`, `GSI2SK
  BETWEEN 'REQUEST#<now>' AND 'REQUEST#9999999999999'` -- the mirror of **Sessions / My
  Hosted Sessions**, same index, `REQUEST#` prefix instead of `SESSION#`.

  **Deploy-only gap, won't show up against `local`:** `RequestController`'s
  `getRequestsByUserIdUseCase` constructor param has no `@Inject(...)`. This compiles and
  works fine under plain `nest start`, but SST's esbuild bundling (used by both `sst dev`
  and `sst deploy`, so this affects the `dev` Bruno environment too) doesn't emit decorator
  metadata, so Nest can't resolve the dependency and the request Lambda fails to boot. If
  every request in this collection suddenly 500s against `dev`, check this first.
}
