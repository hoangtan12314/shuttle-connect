meta {
  name: Get Court by Id - not found
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/courts/does-not-exist
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body.success: eq false
  res.body.error.code: eq ENTITY_NOT_FOUND
}

docs {
  `EntityNotFoundError` extends `NotFoundError`, which `GlobalExceptionFilter` maps to 404.
}
