meta {
  name: Create Court
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/courts
  body: json
  auth: inherit
}

body:json {
  {
    "name": "T19 Badminton",
    "address": "19 Nguyen Huu Canh, Binh Thanh",
    "city": "HCM",
    "district": "HCM_DISTRICT_10",
    "latitude": 10.771505716410465,
    "longitude": 106.66471299999887
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("courtId", res.getBody().data.id);
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}

tests {
  test("returns a court id and echoes the place fields", function () {
    const court = res.getBody().data;
    expect(court.id).to.be.a("string");
    expect(court.city).to.equal("HCM");
    expect(court.district).to.equal("HCM_DISTRICT_10");
  });
}

docs {
  Creates a court and stores its id in the `courtId` environment variable for
  **Create Session** to use.

  `city` must be the short code (`HCM` / `HN` / `DN`) and `district` a value from the
  `Area` enum. The pair is cross-checked against `CITY_AREAS` by `Court.create` --
  see **Create Court (invalid city+district)** for the failure case.

  Persistence note: the item is stored with a single `location` attribute
  (`"HCM#HCM_DISTRICT_10"`); `city` and `district` in this response are derived from it
  on read by `CourtMapper.toResponse`.
}
