meta {
  name: Approve Soon Request
  type: http
  seq: 6
}

patch {
  url: {{apiUrl}}/sessions/{{soonSessionId2}}/requests/{{soonPlayerId2}}
  body: json
  auth: inherit
}

body:json {
  {
    "status": "APPROVED"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.status: eq APPROVED
}

docs {
  Runs as the **host**, on session B. Approves the request so **Withdraw - inside cutoff**
  below has an `APPROVED` request to test the cutoff against.
}
