meta {
  name: Withdraw - inside cutoff
  type: http
  seq: 6
}

patch {
  url: {{apiUrl}}/sessions/{{soonSessionId}}/requests/mine/withdraw
  body: none
  auth: bearer
}

auth:bearer {
  token: {{idToken2}}
}

assert {
  res.status: eq 409
  res.body.success: eq false
  res.body.error.code: eq WITHDRAWAL_WINDOW_CLOSED
}

docs {
  The player's request is `APPROVED` (see **Approve Soon Request**) on a session starting
  only 2h from now, inside `WITHDRAW_CUTOFF_HOURS` (6h). `WithdrawRequestUseCase` now
  blocks this with `WithdrawalWindowClosedError` (409) instead of letting an approved
  slot get released this close to start, when the host likely can't refund or replace it.
}
